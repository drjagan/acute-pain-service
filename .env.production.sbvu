# Acute Pain Service - SBVU Cloudron Production Template
# Deployment: aps.sbvu.ac.in on Cloudron LAMP
#
# Copy to /app/data/.env only when a file-based override is required.
# Cloudron runtime variables are preferred by the application for managed
# services such as MySQL, because Cloudron may rotate those credentials.

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Leave DB_* empty on Cloudron unless intentionally overriding the runtime
# CLOUDRON_MYSQL_* values injected by the platform.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_ENV=production
APP_NAME=Acute Pain Service
APP_VERSION=1.2.1-cloudron
APP_URL=https://aps.sbvu.ac.in
APP_DEBUG=false
APP_KEY=

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_LIFETIME=7200
SESSION_NAME=APS_SESSION

# ============================================
# SECURITY SETTINGS
# ============================================
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT=900

# ============================================
# PAGINATION & DISPLAY
# ============================================
PER_PAGE=20

# ============================================
# LOGGING
# ============================================
LOG_ENABLED=true
LOG_LEVEL=ERROR

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# ============================================
# TIMEZONE
# ============================================
APP_TIMEZONE=Asia/Kolkata

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Prefer Cloudron's CLOUDRON_MAIL_* runtime variables if mail integration is
# wired into application code. Use these SMTP_* fields only as explicit
# file-based overrides.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=aps.app@sbvu.ac.in
SMTP_FROM_NAME=Acute Pain Service - SBVU
SMTP_MAIL_DOMAIN=sbvu.ac.in

# ============================================
# LDAP CONFIGURATION
# ============================================
LDAP_ENABLED=false
LDAP_HOST=
LDAP_PORT=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USERS_BASE_DN=

# ============================================
# CLOUDRON SPECIFIC
# ============================================
CLOUDRON_DEPLOYMENT=true
CLOUDRON_APP_PATH=/app/data
