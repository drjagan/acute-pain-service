<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Cloudron/LAMP: legacy masterdata wrapper directories physically exist.
    # Route canonical masterdata URLs through the front controller first.
    RewriteCond %{REQUEST_URI} !/index\.php($|\?)
    RewriteRule ^masterdata(/.*)?$ index.php [L,QSA]
    
    # Handle Front Controller - Cloudron preserves REQUEST_URI; do not append PATH_INFO
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^.*$ index.php [L,QSA]
</IfModule>
